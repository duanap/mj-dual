{
  "name": "@mj/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rng.node": "./src/rng.node.ts"
  },
  "scripts": {
    "test": "vitest run",
    "sim": "tsx src/sim.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler demo/main.ts",
    "build:demo": "esbuild demo/main.ts --bundle --format=esm --loader:.svg=dataurl --outfile=demo/dist/main.js",
    "demo": "npm run build:demo && node demo/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
